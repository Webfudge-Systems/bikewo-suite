HOST=0.0.0.0
PORT=1337

# Production / Railway template (placeholders only — real values live in .env + .env.production)
NODE_ENV=production
DATABASE_CLIENT=postgres
# Private (API on Railway): postgresql://postgres:PASSWORD@postgres-yo2h.railway.internal:5432/railway
# Public (local laptop):    postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
DATABASE_URL=postgresql://postgres:PASSWORD@postgres-yo2h.railway.internal:5432/railway
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
SEED_DATA=false

PUBLIC_URL=https://bikewo-suite-production.up.railway.app

APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=generate-me
API_TOKEN_SALT=generate-me
TRANSFER_TOKEN_SALT=generate-me
JWT_SECRET=generate-me
ENCRYPTION_KEY=generate-me

REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379
REDIS_ENABLED=true
CACHE_API_ENABLED=true
CACHE_TTL_SECONDS=300

PLATFORM_ADMIN_EMAIL=admin@bikewo.com
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_RESET_PASSWORD=false

LANDING_APP_URL=https://bikewo.in
LANDING_SIGNUP_SECRET=generate-me
WEBSITE_SIGNUP_ORG_ID=1
CRM_APP_URL=https://crm.bikewo.in
PM_APP_URL=https://pm.bikewo.in
ACCOUNTS_APP_URL=https://accounts.bikewo.in
# CORS_EXTRA_ORIGINS=https://preview.example.com
