# Copy values into .env to run Strapi locally against Railway Postgres.
# Use the PUBLIC DATABASE_URL from Railway → Postgres-yO2H → Variables / Connect.
# Never commit .env (gitignored).

HOST=0.0.0.0
PORT=1337
NODE_ENV=development

DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

SEED_DATA=false
PLATFORM_ADMIN_RESET_PASSWORD=false
REDIS_ENABLED=false
CACHE_API_ENABLED=false

PUBLIC_URL=http://localhost:1337

# Use the same APP_KEYS / JWT_* as apps/backend/.env.production (or Railway API vars)
# if you need production-issued tokens to validate locally.
